{
  "name": "@leta-io/components",
  "version": "0.0.1",
  "private": false,
  "description": "LETA React component library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leta-io/leta-web-design.git",
    "directory": "packages/components"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --external leaflet --external lottie-web && rm -rf dist/assets && cp -R src/EmptyState/assets dist/assets && cp src/Avatar/assets/*.png dist/assets/ && cp src/LoadingOverlay/assets/leta-loader.json dist/assets/",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@leta-io/design-tokens": "workspace:*",
    "@leta-io/icons": "workspace:*",
    "country-flag-icons": "^1.6.17",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.12.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.3.6",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
