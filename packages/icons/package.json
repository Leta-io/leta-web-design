{
  "name": "@leta-io/icons",
  "version": "0.0.2",
  "private": false,
  "description": "LETA SVG icon React components",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leta-io/leta-web-design.git",
    "directory": "packages/icons"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "registry": "bun scripts/build-registry.ts",
    "prebuild": "bun scripts/build-registry.ts",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "lint": "eslint src",
    "typecheck": "bun scripts/build-registry.ts && tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@material-symbols/svg-500": "^0.44.5"
  }
}
